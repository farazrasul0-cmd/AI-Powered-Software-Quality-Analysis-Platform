# ==============================================================================
# CodeSentinel AI Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# DUAL-MODE EXECUTION MODES:
# 1. LOCAL STANDALONE DEMO (Zero Docker, sub-second boot, no external dependencies):
#    - Uses SQLite in-memory/file database.
#    - Uses InMemoryVectorStore with cosine similarity and BM25 search.
#    - Uses MockLLMReviewer for deterministic, offline code review triage.
# 2. FULL DISTRIBUTED CLUSTER (Docker Compose):
#    - Uses PostgreSQL 16 + AsyncPG connection pooling.
#    - Uses Redis 7.x message broker with Celery workers.
#    - Uses Qdrant Vector DB on port 6333.
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="CodeSentinel AI"
ENVIRONMENT="development"               # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# --- Database Configuration ---
# Standalone Local Mode (Default fallback):
DATABASE_URL="sqlite+aiosqlite:///./quality_platform.db"
# Distributed Production Mode (Uncomment when using Docker / PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/quality_platform"

# PostgreSQL Credentials (Used by Docker Compose):
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="quality_platform"
POSTGRES_PORT=5432

# --- Asynchronous Worker & Message Broker (Celery / Redis) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# --- Vector Database & RAG Configuration ---
# Options: "memory" (Zero Docker) | "qdrant" (Production Vector DB)
VECTOR_STORE_MODE="memory"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="code_chunks"

# --- LLM Review Engine Configuration ---
# Options: "mock" (Offline deterministic rule-based) | "openai" (Live LLM)
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_TEMPERATURE=0.1

# --- GitHub CI/CD & Webhook Ingestion ---
GITHUB_WEBHOOK_SECRET="test-secret-key-123"
GITHUB_TOKEN=""                        # Optional GitHub Personal Access Token for live PR commenting

# --- Security & CORS ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173"
